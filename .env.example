SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_shop
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Order notifications (email / WhatsApp) -----------------------------------
# Comma-separated list of channels to actually send on. Leave blank to send
# nothing externally -- in-app (bell icon) notifications always work regardless.
ORDER_NOTIFICATION_CHANNELS=email,whatsapp

# If True, every ADMIN-role account is emailed/WhatsApp'd for the full order
# lifecycle (placed, accepted, preparing, ready, assigned, picked up, out for
# delivery, delivered, completed) -- not just cancellations. Set False to go
# back to "cancellations only".
ADMIN_NOTIFY_ALL_ORDER_EVENTS=True

# Prefixed onto any phone number that doesn't already start with "+" (checkout
# phone or a profile's phone) before it's sent to Twilio, since WhatsApp needs
# full international format. Change to your country's code if not Nepal.
DEFAULT_PHONE_COUNTRY_CODE=+977

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank
# to ship no tracking code at all.
GOOGLE_ANALYTICS_ID=

# Email (used when "email" is in ORDER_NOTIFICATION_CHANNELS)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=orders@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=orders@example.com
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True

# WhatsApp via Twilio (used when "whatsapp" is in ORDER_NOTIFICATION_CHANNELS)
# Sign up at https://www.twilio.com/whatsapp -- sandbox is fine for testing.
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
