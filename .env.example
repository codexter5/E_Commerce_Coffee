SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_shop
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# HTTPS / production security -------------------------------------------
# These only take effect when DEBUG=False. Set CSRF_TRUSTED_ORIGINS above to
# your real https:// domain(s) in production, comma-separated.
SECURE_SSL_REDIRECT=True
# Start short while confirming HTTPS is stable (see the comment in
# settings.py for why), then raise to 31536000 (one year) once confident.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Order notifications (email / WhatsApp) -----------------------------------
# Comma-separated list of channels to actually send on. Leave blank to send
# nothing externally -- in-app (bell icon) notifications always work regardless.
ORDER_NOTIFICATION_CHANNELS=email,whatsapp

# If True, every ADMIN-role account is emailed/WhatsApp'd for the full order
# lifecycle (placed, accepted, preparing, ready, assigned, picked up, out for
# delivery, delivered, completed) -- not just cancellations. Set False to go
# back to "cancellations only".
ADMIN_NOTIFY_ALL_ORDER_EVENTS=True

# Prefixed onto any phone number that doesn't already start with "+" (checkout
# phone or a profile's phone) before it's sent to Twilio, since WhatsApp needs
# full international format. Change to your country's code if not Nepal.
DEFAULT_PHONE_COUNTRY_CODE=+977

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank
# to ship no tracking code at all.
GOOGLE_ANALYTICS_ID=

# Store's WhatsApp number for the site-wide "Chat with us" button, "Message
# Support" on order pages, etc. Local (98...) or +E.164. Leave blank to hide
# all store-side WhatsApp buttons (seller/buyer "message" buttons on order
# pages still work independently, since those use the order/seller's own
# phone number rather than this one).
STORE_WHATSAPP_NUMBER=

# Email (used when "email" is in ORDER_NOTIFICATION_CHANNELS)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=orders@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=orders@example.com
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True

# WhatsApp (used when "whatsapp" is in ORDER_NOTIFICATION_CHANNELS) ---------
# Pick a provider: "twilio" or "meta" (Meta's own WhatsApp Cloud API -- no
# third party, no per-message cost on the free tier). Only that provider's
# settings below need to be filled in; the other's are ignored.
WHATSAPP_PROVIDER=twilio

# Option A: Twilio -- sign up at https://www.twilio.com/whatsapp (sandbox is
# fine for testing, but the recipient must first send "join <code>" to the
# sandbox number from WhatsApp).
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option B: Meta WhatsApp Cloud API -- create an app at
# https://developers.facebook.com, add the WhatsApp product, then copy the
# access token and phone number ID from its API Setup page. While the app is
# in development mode, you can only message numbers added to that page's
# recipient list.
META_WHATSAPP_TOKEN=your-meta-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_API_VERSION=v20.0
