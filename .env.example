SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_shop
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Order notifications (email / WhatsApp) -----------------------------------
# Comma-separated list of channels to actually send on. Leave blank to send
# nothing externally -- in-app (bell icon) notifications always work regardless.
ORDER_NOTIFICATION_CHANNELS=email,whatsapp

# Email (used when "email" is in ORDER_NOTIFICATION_CHANNELS)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=orders@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=orders@example.com
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True

# WhatsApp via Twilio (used when "whatsapp" is in ORDER_NOTIFICATION_CHANNELS)
# Sign up at https://www.twilio.com/whatsapp -- sandbox is fine for testing.
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
